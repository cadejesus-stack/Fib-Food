# Banco de dados local. Use valores diferentes e fortes fora do desenvolvimento.
POSTGRES_USER=fibfood
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=fib_food
POSTGRES_PORT=5432

# Usada pelos serviços que aceitam a URL única de conexão.
DATABASE_URL=postgresql+psycopg2://fibfood:change-me-before-running@postgres:5432/fib_food

# Política de liberação de pedidos: cashier_approval ou a opção implementada pelo order-api.
ORDER_RELEASE_MODE=cashier_approval

# Obrigatória quando os serviços de autenticação forem restaurados.
JWT_SECRET=replace-with-a-long-random-secret

# Identidade visual padrão da plataforma; a identidade de cada tenant deve vir do tenant-api.
PLATFORM_NAME=Fib-Food
PLATFORM_SUPPORT_EMAIL=support@example.com
